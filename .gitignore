# Dependencies
node_modules/
package-lock.json

# Results - Allow platform-specific results to be committed by CI
# Individual local results are ignored, but CI results are kept
results/*.json
results/*/*.json
!results/github-actions-*/*.json
!results/.gitkeep

# Charts - Allow platform-specific charts to be committed by CI
charts/*.png
charts/*/*.png
!charts/github-actions-*/*.png
!charts/.gitkeep

# Generated reports - Allow CI-generated reports to be committed
# BENCHMARKS.md
!BENCHMARKS-github-actions-*.md

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
