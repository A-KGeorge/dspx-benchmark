{
  "name": "dspx-benchmarks",
  "version": "1.0.0",
  "description": "Benchmark suite for dspx library",
  "type": "module",
  "scripts": {
    "bench:all": "npm run bench:speed && npm run bench:algo && npm run bench:redis && npm run bench:logging && npm run bench:profiling && npm run charts && npm run report",
    "bench:speed": "node --no-warnings raw-speed.js",
    "bench:algo": "node --no-warnings algorithmic.js",
    "bench:redis": "node --no-warnings redis.js",
    "bench:logging": "node --no-warnings logging.js",
    "bench:profiling": "node --expose-gc profiling.js",
    "charts": "node --no-warnings generate-charts.js",
    "report": "node --no-warnings generate-report.js",
    "regenerate-charts": "node --no-warnings regenerate-charts.js",
    "regenerate-reports": "node --no-warnings regenerate-reports.js"
  },
  "keywords": [
    "benchmark",
    "dsp",
    "performance"
  ],
  "author": "Alan Kochukalam George",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "crypto": "^1.0.1",
    "dsp.js": "^1.0.1",
    "dspx": "^1.2.3",
    "fft.js": "^4.0.4",
    "fili": "^2.0.3",
    "redis": "^5.9.0"
  },
  "main": "common.js"
}
