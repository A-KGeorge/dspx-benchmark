{
  "name": "dspx-benchmarks",
  "version": "1.0.0",
  "description": "Benchmark suite for dspx library",
  "type": "module",
  "scripts": {
    "benchmarks": "npm run bench:speed && npm run bench:algo && npm run bench:persistence && npm run bench:logging && npm run bench:profiling && npm run bench:latency-threaded && npm run bench:concurrency-threaded && npm run bench:audio && npm run bench:audio-threaded && npm run charts && npm run report",
    "bench:speed": "node --no-warnings benchmarks/raw-speed.js",
    "bench:algo": "node --no-warnings benchmarks/algorithmic.js",
    "bench:persistence": "node --no-warnings benchmarks/persistence.js",
    "bench:logging": "node --no-warnings benchmarks/logging.js",
    "bench:profiling": "node --expose-gc benchmarks/profiling.js",
    "bench:latency-threaded": "node --experimental-worker --experimental-vm-modules --no-warnings benchmarks/latency-threaded.js",
    "bench:concurrency-threaded": "node --experimental-worker --experimental-vm-modules --no-warnings benchmarks/concurrency-threaded.js",
    "bench:audio": "node --no-warnings benchmarks/audio-latency.js",
    "bench:audio-threaded": "node --experimental-worker --experimental-vm-modules --no-warnings benchmarks/audio-latency-threaded.js",
    "bench:speed-py": "node scripts/run-python-bench.js raw-speed",
    "bench:algo-py": "node scripts/run-python-bench.js algorithmic",
    "bench:persistence-py": "node scripts/run-python-bench.js persistence",
    "bench:speed-java": "mvn compile exec:java -Dexec.mainClass=RawSpeed -DBENCHMARK_PLATFORM=$BENCHMARK_PLATFORM",
    "bench:algo-java": "mvn compile exec:java -Dexec.mainClass=Algorithmic -DBENCHMARK_PLATFORM=$BENCHMARK_PLATFORM",
    "charts": "node --no-warnings scripts/generate-charts.js",
    "report": "node --no-warnings scripts/generate-report.js",
    "regenerate-charts": "node --no-warnings scripts/regenerate-charts.js",
    "regenerate-reports": "node --no-warnings scripts/regenerate-reports.js"
  },
  "keywords": [
    "benchmark",
    "dsp",
    "performance"
  ],
  "author": "Alan Kochukalam George",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "crypto": "^1.0.1",
    "dsp.js": "^1.0.1",
    "dspx": "^1.4.2",
    "fft.js": "^4.0.4",
    "fili": "^2.0.3",
    "redis": "^5.10.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
